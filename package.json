{
  "name": "quimica-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/gen-catalog.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-catalog.mjs",
    "build": "next build",
    "dev:operador": "node scripts/gen-catalog.mjs && node scripts/operador-media.mjs && next dev operador -p 3001",
    "build:operador": "node scripts/gen-catalog.mjs && node scripts/operador-media.mjs && next build operador",
    "start:operador": "next start operador -p 3001",
    "start": "next start",
    "lint": "eslint",
    "check": "node scripts/gen-catalog.mjs --check && node scripts/check-quiz.mjs",
    "check:certs": "node scripts/check-certs.mjs",
    "check:repaso": "node scripts/check-repaso.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:cloud": "node scripts/check-cloud.mjs",
    "check:sim": "node scripts/check-sim.mjs",
    "check:problemas": "node scripts/check-problemas.mjs",
    "check:operador": "node scripts/check-operador.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jiti": "^2.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    }
  }
}
